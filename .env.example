APP_MODE=all
HTTP_ADDR=:8080
LOG_LEVEL=INFO
EXTERNAL_API_TIMEOUT=10s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
REGISTRY_CONFIG_PATH=config/bots.yml
REGISTRY_LOCK_PATH=registry/bots.lock.json
REGISTRY_BOTS_DIR=registry/bots
TELEGRAM_API_BASE_URL=https://api.telegram.org
WORKER_BUFFER=32
REDIS_URL=redis://redis:6379
POSTGRES_URL=

BOT_SAMPLE_ECHO_TOKEN=123456:replace-me
BOT_SAMPLE_ECHO_WEBHOOK_SECRET=replace-with-long-random-string

# Workbot — бот подработок
BOT_WORKBOT_TOKEN=123456:replace-me
BOT_WORKBOT_WEBHOOK_SECRET=replace-with-long-random-string
WORKBOT_ADMIN_TOKEN=replace-with-admin-password

GHCR_IMAGE=ghcr.io/dimatolpygin/bots-platform
IMAGE_TAG=latest
HOST_PORT=8080


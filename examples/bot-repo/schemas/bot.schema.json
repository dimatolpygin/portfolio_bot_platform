{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/bot.schema.json",
  "title": "Telegram Bot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "description",
    "enabled",
    "module",
    "welcome_message",
    "telegram"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "welcome_message": {
      "type": "string",
      "minLength": 1
    },
    "telegram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_env",
        "webhook_secret_env"
      ],
      "properties": {
        "token_env": {
          "type": "string",
          "minLength": 1
        },
        "webhook_secret_env": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "enabled"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "schedule": {
            "type": "string"
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": true
    },
    "env_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required",
          "secret"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}

